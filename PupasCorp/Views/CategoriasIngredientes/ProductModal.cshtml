@using PupasCorp.Models.ViewModels
@model CategoriaIngre

<!--Modal-->
<!-- Modal de Producto -->
<div id="productModal" class="modal">
    <div class="modal-content">
        <span id="closeModalProduct" class="close">&times;</span>

        <form enctype="multipart/form-data" asp-action="Create">
            <div class="form-group">
                <label class="image-upload" for="product-image">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <div class="image-upload-text">
                        <strong>Haga clic para subir</strong> o arrastre una imagen aquí
                    </div>
                    <input asp-for="Foto" type="file" id="product-image" class="file-input" accept="image/*" onchange="previewImage(event)">
                </label>
            </div>

            <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" asp-for="Nombre" id="nombre" name="nombre" placeholder="Nombre del producto" class="form-control">
            </div>

            <div class="form-group">
                <label for="descripcion">Descripción</label>
                <textarea id="descripcion" asp-for="Descripcion" name="descripcion" placeholder="Describe el producto..." class="form-control"></textarea>
            </div>

            <div class="form-actions">
                <button type="button" id="closeModalBtnProduct" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>

    </div>
</div>

<script>
    function previewImage(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                // Limitar la búsqueda de la vista previa solo dentro del modal donde se disparó el evento
                const modal = event.target.closest('.modal');
                    const uploadText = modal.querySelector('.image-upload-text');
                    uploadText.innerHTML = `
                        <img src="${e.target.result}" alt="Vista previa"
                    style="max-width: 50%; max-height: 25%; margin-top: 10px;
                    border: 1px solid #ccc; padding: 5px;">`;
            };
            reader.readAsDataURL(file);
            }
        }
</script>
