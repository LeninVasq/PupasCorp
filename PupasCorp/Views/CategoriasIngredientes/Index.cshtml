@model List<CategoriasIngrediente>
@using PupasCorp.Models.ViewModels


@await Html.PartialAsync("Actualizar", new CategoriaIngre())

@await Html.PartialAsync("ProductModal", new CategoriaIngre())


<div class="containerCategoriasIngredientes">

    <div class="ContainerBtnTitle">
        <h1 class="page-title">Categorías de Productos</h1>

        <button id="openModalBtn" class="btn-add">
            <span class="btn-icon">+</span>
            <span class="btn-text">Agregar</span>
        </button>
    </div>

    <div class="category-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var categoriasIngrediente in Model)
            {
                <div class="category-card">
                    <div class="card-header">
                        <div class="card-title-row">
                            <h3 class="card-title">@Html.DisplayFor(m => categoriasIngrediente.Nombre)</h3>
                            <span class="product-count">@Html.DisplayFor(m => categoriasIngrediente.IdCategoriasIngredientes)</span>
                        </div>
                    </div>
                    <div class="card-content">
                        <div class="image-container">
                            <img src="@categoriasIngrediente.Foto"
                                 alt="Electrónicos"
                                 class="category-image" />
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="button-container">
                            
                <form asp-controller="Ingredientes" asp-action="Index" method="get">
                    <input type="hidden" name="id" value="@categoriasIngrediente.IdCategoriasIngredientes" />
                    <button type="submit" class="btn btn-primary">Producto</button>
                </form>



                            <button class="btn btn-secondary openModalBtnActu"
                            data-id="@categoriasIngrediente.IdCategoriasIngredientes"
                            data-nombre="@categoriasIngrediente.Nombre"
                            data-foto="@categoriasIngrediente.Foto"
                                    data-descrip="@categoriasIngrediente.Descripcion"
                            data-estado="@categoriasIngrediente.Estado">
                            Actualizar
                            </button>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state-section">
                <div class="empty-state">
                    <p class="empty-message">No hay categorías disponibles</p>
                </div>
            </div>
        }
    </div>
</div>



<!--Script modal-->

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var modal = document.getElementById("Actualizar");
        var closeModalBtn = document.getElementById("closeModalActualizar");
        var openModalBtns = document.querySelectorAll(".openModalBtnActu"); // Selecciona todos los botones "Actualizar"
        var inputId = document.getElementById("categoriaId");
        var closeModalBtnActualizar = document.getElementById("closeModalBtnActualizar");

            var inputNombre = document.getElementById("Nombre");
            var inputFoto = document.getElementById("fotoBase64");
            var inputDesc = document.getElementById("descripcion");
            var inputEstado = document.getElementById("estadoCateIngre");

            openModalBtns.forEach(function (btn) {
                btn.onclick = function () {
                var categoriaId = btn.getAttribute("data-id"); 
                var CategoriaNombre = btn.getAttribute("data-nombre");
                var CategoriaFoto = btn.getAttribute("data-foto");
                var CategoriaDescrip = btn.getAttribute("data-descrip");
                    var CategoriaEstado = btn.getAttribute("data-estado");
              if(CategoriaEstado == "True"){
                        estado = 1;
                }
                else{
                    estado = 0;
                    }
                if (inputId) {
                    inputId.value = categoriaId;
                    }
                if(inputNombre)inputNombre.value = CategoriaNombre;
                     if(inputFoto)inputFoto.value = CategoriaFoto;
     if(inputFoto)inputDesc.value = CategoriaDescrip;
                          if(inputEstado)inputEstado.value = estado;


                modal.style.display = "block"; // Muestra el modal
            };
            });

    if (closeModalBtnActualizar) {
        closeModalBtnActualizar.addEventListener("click", function (event) {
                event.preventDefault(); 
                modal.style.display = "none";
            });
        }
        closeModalBtn.onclick = function () {
                modal.style.display = "none";
            };

            window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
            }
            };
        });
</script>


<script>
        document.addEventListener("DOMContentLoaded", function () {
        var modal = document.getElementById("productModal");
        var closeModalBtn = document.getElementById("closeModalProduct");
        var closeModalBtnProduct = document.getElementById("closeModalBtnProduct");
        var openModalBtn = document.getElementById("openModalBtn"); 

        if (openModalBtn) {
            openModalBtn.onclick = function () {
                modal.style.display = "block";
            };
        }

         if (closeModalBtn) {
        closeModalBtn.addEventListener("click", function () {
            modal.style.display = "none";
        });
    }

        if (closeModalBtnProduct) {
        closeModalBtnProduct.addEventListener("click", function (event) {
            event.preventDefault(); // Evita cualquier comportamiento inesperado del botón
            modal.style.display = "none";
        });
    }
        window.onclick = function (event) {
            if (event.target === modal) {
                modal.style.display = "none";
            }
        };
    });

</script>

<!--Script para mostrar la img-->




@if (TempData["Mensaje"] != null)
{
    <script>
        var mensaje = "@Html.Raw(TempData["Mensaje"])";
        alert(mensaje);
    </script>
}