@using PupasCorp.Models.ViewModels
@model PlatilloI


<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 20px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #007bff;
    }

        input:checked + .slider:before {
            transform: translateX(20px);
        }

</style>
<!--Modal-->
<div id="PlatilloCreate" class="modal">
    <div class="modal-content">
        <span class="close" id="closeModalPlatilloCreate">&times;</span>

        <form enctype="multipart/form-data"  asp-action="Create">
            <div class="form-group">
                <label class="image-upload" for="product-image">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <div class="image-upload-text">
                        <strong>Haga clic para subir</strong> o arrastre una imagen aquí
                    </div>
                    <input asp-for="fotob" type="file" id="product-image" class="file-input" accept="image/*" onchange="previewImage(event)">
                </label>
            </div>


            <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" asp-for="Nombre" id="Nombre" name="nombre" placeholder="Nombre del producto" class="form-control">
            </div>

            <div class="form-group">
                <label for="descripcion">Comentario</label>
                <textarea id="descripcion" asp-for="Comentario" name="Comentario" placeholder="Describe el producto..." class="form-control"></textarea>
            </div>
            <div class="form-group ">

                <label>Si quiere que este platillo le aparesca a todos deje la opcion en mostrar</label>
                <label class="switch ">
                    <input type="checkbox" id="estadoCatein">
                    <span class="slider round"></span>
                </label>
                <label for="estado" id="estadoLabelCateIngre">Activo</label>

                <input type="hidden" asp-for="Mostrar" id="estadoCateIngre" value="0" name="Mostrar">
            </div>


            <div class="form-actions">
                <button type="button" id="closeModalBtnPlatilloCreate" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        let estado = document.getElementById("estadoCatein");
        let label = document.getElementById("estadoLabelCateIngre");
        let estadoentrante = document.getElementById("estadoCateIngre");

        function actualizarCheckbox() {
            let valorDelBackend = estadoentrante.value.trim();

            if (valorDelBackend === "1") {
                estado.checked = true;
                label.textContent = "Mostrar";
            } else {
                estado.checked = false;
                label.textContent = "No mostrar";
            }
        }

        let valorAnterior = estadoentrante.value;

        setInterval(() => {
            if (estadoentrante.value !== valorAnterior) {
                valorAnterior = estadoentrante.value;
                actualizarCheckbox();
            }
        }, 200);

        estado.addEventListener("change", function () {
            estadoentrante.value = estado.checked ? "1" : "0";
            label.textContent = estado.checked ? "Mostrar" : "No mostrar";
        });

        actualizarCheckbox();
    });
</script>

<script>
    function previewImage(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                // Limitar la búsqueda de la vista previa solo dentro del modal donde se disparó el evento
                const modal = event.target.closest('.modal');
                const uploadText = modal.querySelector('.image-upload-text');
                uploadText.innerHTML = `
                            <img src="${e.target.result}" alt="Vista previa"
                        style="max-width: 50%; max-height: 25%; margin-top: 10px;
                        border: 1px solid #ccc; padding: 5px;">`;
            };
            reader.readAsDataURL(file);
        }
    }
</script>



