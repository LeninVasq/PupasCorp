@using PupasCorp.Models.ViewModels
@model PlatilloI


<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 20px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #007bff;
    }

        input:checked + .slider:before {
            transform: translateX(20px);
        }

</style>
<!--Modal-->
<div id="PlatilloUpdate" class="modal">
    <div class="modal-content">
        <span class="close" id="closeModalPlatilloUpdate">&times;</span>

        <form enctype="multipart/form-data" asp-action="update">
            <div class="form-group">
                <label class="image-upload" for="Fotos">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <div class="image-upload-text Platilloupdate-preview">
                        <strong>Haga clic para subir</strong> o arrastre una imagen aquí
                    </div>
                    <input type="file" id="Fotos" class="file-input" accept="image/*"
                           onchange="Image(event, 'Platilloupdate-preview')">
                </label>
            </div>

            <input type="hidden" asp-for="Foto" id="fotoBase64PlatilloUpdate" name="Foto" />

            <input type="hidden" asp-for="IdPlatillo" id="IdPlatillo" name="IdPlatillo" />

            <div class="form-group">
                <label for="nombre">Nombre update</label>
                <input type="text" asp-for="Nombre" id="Nombreplatillo" name="nombre" placeholder="Nombre del producto" class="form-control">
            </div>

            <div class="form-group">
                <label for="descripcion">Comentario</label>
                <textarea  asp-for="Comentario" id="Comentario" name="Comentario" placeholder="Describe el producto..." class="form-control"></textarea>
            </div>
            <div class="form-group ">

                <label>Si quiere que este platillo le aparesca a todos deje la opcion en mostrar</label>
                <label class="switch ">
                    <input type="checkbox" id="estadoplatillo">
                    <span class="slider round"></span>
                </label>
                <label for="estado" id="estadoplatillolabel">Activo</label>

                <input type="hidden" asp-for="Mostrar" id="estadoPlatillo" value="0" name="Mostrar">
            </div>


            <div class="form-actions">
                <button type="button" id="closeModalBtnPlatilloUpdate" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        let estado = document.getElementById("estadoplatillo");
        let label = document.getElementById("estadoplatillolabel");
        let estadoentrante = document.getElementById("estadoPlatillo");

        function actualizarCheckbox() {
            let valorDelBackend = estadoentrante.value.trim();

            if (valorDelBackend === "1") {
                estado.checked = true;
                label.textContent = "Mostrar";
            } else {
                estado.checked = false;
                label.textContent = "No mostrar";
            }
        }

        let valorAnterior = estadoentrante.value;

        setInterval(() => {
            if (estadoentrante.value !== valorAnterior) {
                valorAnterior = estadoentrante.value;
                actualizarCheckbox();
            }
        }, 200);

        estado.addEventListener("change", function () {
            estadoentrante.value = estado.checked ? "1" : "0";
            label.textContent = estado.checked ? "Mostrar" : "No mostrar";
        });

        actualizarCheckbox();
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let Base64 = document.getElementById("fotoBase64PlatilloUpdate");

        const intervalo = setInterval(() => {
            if (Base64 && Base64.value.trim()) {
                mostrarVistaPrevia(Base64.value, 'Platilloupdate-preview');
                clearInterval(intervalo);
            }
        }, 200);

        let lastValue = Base64.value;
        setInterval(() => {
            if (Base64.value !== lastValue) {
                lastValue = Base64.value;
                mostrarVistaPrevia(Base64.value, 'Platilloupdate-preview');
            }
        }, 200);
    });

    function Image(event, previewClass) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const base64String = e.target.result;

                let inputBase64 = document.getElementById("fotoBase64PlatilloUpdate");
                if (inputBase64) {
                    inputBase64.value = base64String;
                }

                mostrarVistaPrevia(base64String, previewClass);
            };
            reader.readAsDataURL(file);
        }
    }

    function mostrarVistaPrevia(base64, previewClass) {
        const previewContainer = document.querySelector(`.${previewClass}`);
        if (previewContainer) {
            previewContainer.innerHTML = base64
                ? `<img src="${base64}" alt="Vista previa"
                            style="max-width: 50%; max-height: 25%; margin-top: 10px;
                            border: 1px solid #ccc; padding: 5px;">`
                : `<p>No hay imagen seleccionada.</p>`;
        }
    }
</script>



