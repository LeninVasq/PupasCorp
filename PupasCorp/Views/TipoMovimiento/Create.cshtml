@using PupasCorp.Models.ViewModels
@model TipoMovimiento

<!--Modal-->
<!-- Modal de Producto -->
<div id="TipoMovimientoModal" class="modal">
    <div class="modal-content">
        <span id="closeModalTipoMovimiento" class="close">&times;</span>

        <form enctype="multipart/form-data" asp-action="Create">



            <div class="form-group">
                <label for="nombre">Tipo de movimiento</label>
                <input type="text" asp-for="TipoMovimientos" id="nombre" name="TipoMovimientos" placeholder="Nombre del producto" class="form-control">
            </div>


            <div class="form-actions">
                <button type="button" id="closeModalBtnTipoMovimiento" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>

    </div>
</div>