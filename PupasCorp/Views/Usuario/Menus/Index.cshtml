@model List<Menu>
@using PupasCorp.Models.ViewModels

<!-- Estilos personalizados -->
<style>
    .containerCategoriasIngredientes {
        padding: 20px;
    }

    .ContainerBtnTitle {
        margin-bottom: 20px;
        text-align: center;
    }

    .page-title {
        font-size: 32px;
        font-weight: bold;
        color: #444;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .category-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        overflow: hidden;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        }

    .card-header {
        padding: 16px;
        background: #f8f8f8;
        border-bottom: 1px solid #eee;
    }

    .card-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-title {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        color: #333;
    }

    .product-count {
        color: #28a745;
        font-weight: bold;
    }

    .card-content .image-container {
        width: 100%;
        height: 180px;
        overflow: hidden;
    }

    .category-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .empty-state-section {
        text-align: center;
        padding: 40px;
    }

    .empty-message {
        font-size: 20px;
        color: #888;
    }
</style>

<!-- Contenido -->
<div class="containerCategoriasIngredientes">
    <div class="ContainerBtnTitle">
        <h1 class="page-title">Menús Disponibles</h1>
    </div>

    <div class="category-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var menu in Model)
            {
                <div class="category-card" onclick="window.location.href='@Url.Action("DetalleMenu", "Menu", new { id = menu.IdMenu })'">
                    <div class="card-header">
                        <div class="card-title-row">
                            <h3 class="card-title">@menu.Nombre</h3>
                            <span class="product-count">$@menu.Precio</span>
                        </div>
                    </div>

                    <div class="card-content">
                        <div class="image-container">
                            <img src="@menu.Foto"
                                 alt="@menu.Nombre"
                                 class="category-image" />
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state-section">
                <p class="empty-message">No hay menús disponibles.</p>
            </div>
        }
    </div>
</div>

<!-- Script para mostrar mensaje si existe -->
@if (TempData["Mensaje"] != null)
{
    <script>
        var mensaje = "@Html.Raw(TempData["Mensaje"])";
        alert(mensaje);
    </script>
}
