@model List<Platillo>
@using PupasCorp.Models.ViewModels

@await Html.PartialAsync("Create", new PlatilloI())
@await Html.PartialAsync("Update", new PlatilloI())

<style>
    .containerCategoriasIngredientes {
        padding: 20px;
        max-width: 1200px;
        margin: auto;
    }

    .ContainerBtnTitle {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: bold;
        color: #333;
    }

    .btn-add {
        background-color: #4CAF50;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 10px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .btn-add:hover {
            background-color: #45a049;
        }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
    }

    .category-card {
        background-color: #fff;
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .category-card.shadow {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .category-card:hover {
            transform: translateY(-5px);
        }

    .image-container {
        width: 100%;
        height: 180px;
        overflow: hidden;
    }

    .category-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-bottom: 1px solid #ddd;
    }

    .card-details {
        padding: 15px;
        text-align: center;
    }

    .card-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: #222;
        margin-bottom: 8px;
    }

    .platillo-id {
        font-size: 0.85rem;
        color: #888;
    }

    .add-cart-form {
        text-align: center;
        padding: 15px;
    }

    .btn-cart {
        background-color: #ff7043;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .btn-cart:hover {
            background-color: #ff5722;
        }

</style>
<div class="containerCategoriasIngredientes">

    <div class="ContainerBtnTitle">
        <h1 class="page-title">Platillos</h1>

        <button id="openModalBtnPlatillo" class="btn-add">
            <span class="btn-icon">+</span>
            <span class="btn-text">Agregar</span>
        </button>
    </div>

    <div class="category-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var platillo in Model)
            {
                <div class="category-card shadow">
                    <div class="card-content">
                        <div class="image-container">
                            <img src="@platillo.Foto"
                                 alt="@platillo.Nombre"
                                 class="category-image" />
                        </div>

                        <div class="card-details">
                            <h3 class="card-title">@platillo.Nombre</h3>
                            <span class="platillo-id">ID: @platillo.IdPlatillo</span>
                        </div>

                        <form asp-controller="Carrito" asp-action="Agregar" method="post" class="add-cart-form">
                            <input type="hidden" name="idPlatillo" value="@platillo.IdPlatillo" />
                            <button type="submit" class="btn-cart">
                                🛒 Agregar al carrito
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state-section">
                <div class="empty-state">
                    <p class="empty-message">No hay platillos disponibles</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Mantenemos los scripts para los modales de creación y actualización (por si los necesitas para el botón +) -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var modal = document.getElementById("PlatilloCreate");
        var closeModalBtn = document.getElementById("closeModalPlatilloCreate");
        var closeModalBtnProduct = document.getElementById("closeModalBtnPlatilloCreate");
        var openModalBtn = document.getElementById("openModalBtnPlatillo");

        if (openModalBtn) {
            openModalBtn.onclick = function () {
                modal.style.display = "block";
            };
        }

        if (closeModalBtn) {
            closeModalBtn.addEventListener("click", function () {
                modal.style.display = "none";
            });
        }

        if (closeModalBtnProduct) {
            closeModalBtnProduct.addEventListener("click", function (event) {
                event.preventDefault();
                modal.style.display = "none";
            });
        }

        window.onclick = function (event) {
            if (event.target === modal) {
                modal.style.display = "none";
            }
        };
    });
</script>

@if (TempData["Mensaje"] != null)
{
    <script>
        var mensaje = "@Html.Raw(TempData["Mensaje"])";
        alert(mensaje);
    </script>
}
