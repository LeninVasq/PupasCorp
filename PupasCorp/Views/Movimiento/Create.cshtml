@using PupasCorp.Models.ViewModels
@model Movimientos

<!--Modal-->
<!-- Modal de Producto -->
<div id="MovimientoCreate" class="modal">
    <div class="modal-content">
        <span id="closeModalMovimientoCreate" class="close">&times;</span>

        <form enctype="multipart/form-data" asp-controller="Movimiento" asp-action="Create">


            <input type="hidden" asp-for="IdIngrediente" id="IdIngre" name="IdIngrediente" placeholder="Nombre del producto" class="form-control">

            <div class="form-group">
                <label asp-for="IdTipoMovimientos" class="control-label"></label>
                <select asp-for="IdTipoMovimientos" class="form-control" asp-items="ViewBag.Movimiento">
                </select>
                <span asp-validation-for="IdTipoMovimientos" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label for="nombre">Costo Unitario</label>
                <input type="number" asp-for="CostoUnitario" id="nombre" step="0.01" name="CostoUnitario" placeholder="Nombre del producto" class="form-control">
            </div>

            <div class="form-group">
                <label for="nombre">Cantidad</label>
                <input type="number" asp-for="Cantidad" id="nombre"  step="0.01" name="Cantidad" placeholder="Nombre del producto" class="form-control">
            </div>

            <div class="form-group">
                <label for="nombre">Fecha vencimiento</label>
                <input type="date" asp-for="FechaVencimiento" id="nombre" name="FechaVencimiento" class="form-control">
            </div>

            <div class="form-group">
                <label for="descripcion">Motivo</label>
                <textarea id="descripcion" asp-for="Motivo" name="Motivo" placeholder="Motivo del movimiento..." class="form-control"></textarea>
            </div>

            <div class="form-actions">
                <button type="button" id="closeModalBtnMovimientoCreate" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>

    </div>
</div>

