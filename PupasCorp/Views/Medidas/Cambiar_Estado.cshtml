@using PupasCorp.Models.ViewModels
@model Medida

<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 20px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #007bff;
    }

        input:checked + .slider:before {
            transform: translateX(20px);
        }

</style>

<div id="Update" class="modal">
    <div class="modal-content">
        <span id="UpdateMedidaClose" class="close">&times;</span>

        <form enctype="multipart/form-data"  asp-action="Cambiar_estado">
            <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" asp-for="Nombre" id="Nombre" name="Nombre" placeholder="Nombre del producto" class="form-control">
            </div>

            <label class="switch mt-3">
                <input type="checkbox" id="estado">
                <span class="slider round"></span>
            </label>
            <label for="estado" id="estadoLabel">Activo</label>

            <input type="hidden" asp-for="IdUnidadMedida" id="idunidad" name="IdUnidadMedida" placeholder="Nombre del producto" class="form-control">

            <input type="hidden" asp-for="Estado" id="estadoHidden" name="Estado">



            <div class="form-actions">
                <button type="button" id="UpdateMedidaCloseBtn" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>

    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        let estado = document.getElementById("estado");
        let label = document.getElementById("estadoLabel");
        let estadoHidden = document.getElementById("estadoHidden");

        function actualizarCheckbox() {
            let valorDelBackend = estadoHidden.value.trim();
            console.log("Nuevo valor recibido:", valorDelBackend);

            if (valorDelBackend === "1") {
                estado.checked = true;
                label.textContent = "Activo";
            } else {
                estado.checked = false;
                label.textContent = "Inactivo";
            }
        }

        let valorAnterior = estadoHidden.value;  

        setInterval(() => {
            if (estadoHidden.value !== valorAnterior) {
                valorAnterior = estadoHidden.value;
                actualizarCheckbox();
            }
        }, 200); 

        estado.addEventListener("change", function () {
            estadoHidden.value = estado.checked ? "1" : "0";
            label.textContent = estado.checked ? "Activo" : "Inactivo";
        });

        actualizarCheckbox();
    });
</script>