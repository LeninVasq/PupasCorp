@using PupasCorp.Models.ViewModels
@model Menus

<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 20px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #007bff;
    }

        input:checked + .slider:before {
            transform: translateX(20px);
        }

</style>
<!--Modal-->
<div id="MenuModal" class="modal">
    <div class="modal-content">
        <span class="close" id="closeModalMenu">&times;</span>

        <form enctype="multipart/form-data" asp-action="Create">
            <div class="form-group">
                <label class="image-upload" for="Fotos">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <div class="image-upload-text createmenu-preview">
                        <strong>Haga clic para subir</strong> o arrastre una imagen aquí
                    </div>
                    <input type="file" id="Fotos" class="file-input" accept="image/*"
                           onchange="Image(event, 'createmenu-preview')">
                </label>
            </div>

            <input type="hidden" asp-for="Foto" id="fotoBase64Menu" name="Foto" />


            <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" asp-for="Nombre" id="Nombre" name="Nombre" placeholder="Nombre del producto" class="form-control">
            </div>

            <div class="form-group">
                <label for="nombre">Precio</label>
                <input type="number" asp-for="Precio" id="precio" name="Precio" placeholder="Precio del producto" class="form-control" step="0.01">
            </div>

            <div class="form-group">
                <label for="descripcion">Descripción</label>
                <textarea id="descripcion" asp-for="Descripcion" name="Descripcion" placeholder="Describe el producto..." class="form-control"></textarea>
            </div>

            


            <div class="form-actions">
                <button type="button" id="closeModalBtnMenu" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        let Base64 = document.getElementById("fotoBase64Menu");

        const intervalo = setInterval(() => {
            if (Base64 && Base64.value.trim()) {
                mostrarVistaPrevia(Base64.value, 'createmenu-preview');
                clearInterval(intervalo);
            }
        }, 200);

        let lastValue = Base64.value;
        setInterval(() => {
            if (Base64.value !== lastValue) {
                lastValue = Base64.value;
                mostrarVistaPrevia(Base64.value, 'createmenu-preview');
            }
        }, 200);
    });

    function Image(event, previewClass) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const base64String = e.target.result;

                let inputBase64 = document.getElementById("fotoBase64Menu");
                if (inputBase64) {
                    inputBase64.value = base64String;
                }

                mostrarVistaPrevia(base64String, previewClass);
            };
            reader.readAsDataURL(file);
        }
    }

    function mostrarVistaPrevia(base64, previewClass) {
        const previewContainer = document.querySelector(`.${previewClass}`);
        if (previewContainer) {
            previewContainer.innerHTML = base64
                ? `<img src="${base64}" alt="Vista previa"
                                style="max-width: 50%; max-height: 25%; margin-top: 10px;
                                border: 1px solid #ccc; padding: 5px;">`
                : `<p>No hay imagen seleccionada.</p>`;
        }
    }
</script>



