@using PupasCorp.Models.ViewModels
@model MenuIngre


<div id="MenuIngreModal" class="modal">
    <div class="modal-content">
        <span id="closeModalMenuIngre" class="close">&times;</span>

        <form enctype="multipart/form-data" asp-action="Create">
            <div class="form-group">
                <label asp-for="IdIngrediente" class="control-label">Ingrediente</label>
                <select asp-for="IdIngrediente" class="form-control" asp-items="ViewBag.Ingredientes">
                </select>
                <span asp-validation-for="IdIngrediente" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="nombre">Cantidad</label>
                <input type="number" asp-for="Cantidad" id="nombre" name="Cantidad" placeholder="Nombre del producto" class="form-control">
            </div>
            <div class="form-actions">
                <button type="button" id="closeModalBtnMenuIngre" class="btns btns-secondary">Cerrar</button>
                <button type="submit" class="btns btns-primary">Guardar cambios</button>
            </div>
        </form>

    </div>
</div>