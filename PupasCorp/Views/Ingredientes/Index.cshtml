@model List<Ingrediente>
@using PupasCorp.Models.ViewModels


@await Html.PartialAsync("Create", new Ingredien())
@await Html.PartialAsync("Update", new Ingredien())

<div class="containerCategoriasIngredientes">

    <div class="ContainerBtnTitle">
        <h1 class="page-title">Lista de productos</h1>

        <button id="openModalBtn" class="btn-add">
            <span class="btn-icon">+</span>
            <span class="btn-text">Agregar</span>
        </button>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Foto</th>
                <th scope="col">Nombre</th> 
                <th scope="col">Descripcion</th>
                <th scope="col">Sctok</th>
                <th scope="col">Medida</th>
                <th scope="col">Estado</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var ingredientes in Model)
                {
                    <tr>
                        <th scope="row">@Html.DisplayFor(m => ingredientes.IdIngrediente)</th>
                        <td style="padding: 0; margin: 0;">
                            <img src="@ingredientes.Foto"
                                 alt="Electrónicos"
                                 style="max-width: 15%; max-height: 15%; display: block; width: auto; height: auto;"
                                 class="category-image" />
                        </td>
                        <td>@Html.DisplayFor(m => ingredientes.Nombre)</td>

                        <td>@Html.DisplayFor(m => ingredientes.Descripcion)</td>
                        <td>@Html.DisplayFor(m => ingredientes.Stock)</td>
                        <td>@Html.DisplayFor(m => ingredientes.Nombre)</td>
                        @if (ingredientes.Estado == true)
                        {
                            <td>Activo</td>
                        }
                        else
                        {
                            <td>Inactivo</td>

                        }

                        <td>
                            <button class="btn btn-secondary openModalBtnActuCate"
                                    data-id="@ingredientes.IdIngrediente"
                                    data-nombre="@ingredientes.Nombre"
                                    data-foto="@ingredientes.Foto"
                                    data-descrip="@ingredientes.Descripcion"
                                    data-estado="@ingredientes.Estado">
                                Actualizar
                            </button>
                        </td>
                    </tr>
                }

            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align: center;">No hay ingredientes en esta categoría</td>
                </tr>

            }


        </tbody>
    </table>
</div>


@if (TempData["Update"] != null)
{
    <script>
        var mensaje = "@Html.Raw(TempData["Update"])";
        alert(mensaje);
    </script>
}


<script>
    document.addEventListener("DOMContentLoaded", function () {
        var modal = document.getElementById("Actualizar");
        var closeModalBtn = document.getElementById("closeModalActualizarCateIngre");
        var openModalBtns = document.querySelectorAll(".openModalBtnActuCate"); // Selecciona todos los botones "Actualizar"
        var inputId = document.getElementById("IdIngrediente");
        var closeModalBtnActualizar = document.getElementById("closeModalBtnActualizarCateIngre");

        var inputNombre = document.getElementById("Nombre");
        var inputFoto = document.getElementById("fotoBase64");
        var inputDesc = document.getElementById("descripcioncateingre");
        var inputEstado = document.getElementById("estadoCateIngre");

        openModalBtns.forEach(function (btn) {
            btn.onclick = function () {
                var categoriaId = btn.getAttribute("data-id");
                var CategoriaNombre = btn.getAttribute("data-nombre");
                var CategoriaFoto = btn.getAttribute("data-foto");
                var CategoriaDescrip = btn.getAttribute("data-descrip");
                var CategoriaEstado = btn.getAttribute("data-estado");
                if (CategoriaEstado == "True") {
                    estado = 1;
                }
                else {
                    estado = 0;
                }
                if (inputId) {
                    inputId.value = categoriaId;
                }
                if (inputNombre) inputNombre.value = CategoriaNombre;
                if (inputFoto) inputFoto.value = CategoriaFoto;
                if (inputFoto) inputDesc.value = CategoriaDescrip;
                if (inputEstado) inputEstado.value = estado;


                modal.style.display = "block"; // Muestra el modal
            };
        });

        if (closeModalBtnActualizar) {
            closeModalBtnActualizar.addEventListener("click", function (event) {
                event.preventDefault();
                modal.style.display = "none";
            });
        }
        closeModalBtn.onclick = function () {
            modal.style.display = "none";
        };

        window.onclick = function (event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        };
    });
</script>




<script>
        document.addEventListener("DOMContentLoaded", function () {
        var modal = document.getElementById("IngreModal");
        var closeModalBtn = document.getElementById("closeModalProduct");
        var closeModalBtnProduct = document.getElementById("closeModalBtnProduct");
        var openModalBtn = document.getElementById("openModalBtn");

        if (openModalBtn) {
            openModalBtn.onclick = function () {
                modal.style.display = "block";
            };
        }

         if (closeModalBtn) {
        closeModalBtn.addEventListener("click", function () {
            modal.style.display = "none";
        });
    }

        if (closeModalBtnProduct) {
        closeModalBtnProduct.addEventListener("click", function (event) {
            event.preventDefault(); // Evita cualquier comportamiento inesperado del botón
            modal.style.display = "none";
        });
    }
        window.onclick = function (event) {
            if (event.target === modal) {
                modal.style.display = "none";
            }
        };
    });

</script>